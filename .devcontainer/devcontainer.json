{
  "name": "h5g-codespaces",
  "image": "mcr.microsoft.com/devcontainers/python:3.10",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r backend/requirements.txt && cd frontend && npm install",
  "forwardPorts": [5001, 5173],
  "portsAttributes": {
    "5001": {
      "label": "Flask API"
    },
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "openBrowser"
    }
  }
}
